# Copy to .env and fill in your values.

# --- Run mode ---
RUN_MODE=backtest          # backtest | live

# --- Alpaca (backtest / paper) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET=
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex       # iex (free, ~2-3% of volume) | sip (paid, full market).
                           # Volume signals are calibrated for full volume — use sip if you can.

# --- Broker selection ---
BROKER=alpaca              # alpaca (default) | ibkr — ibkr needs TWS/IB Gateway running locally

# --- IBKR (live; used when BROKER=ibkr) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497             # 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live
IBKR_CLIENT_ID=1

# --- Liquid Co-Invest broker ---
USE_LIQUID_BROKER=false    # true to route orders through Liquid instead of IBKR
LIQUID_API_KEY=

# --- LLM (pick one — Gemini is free, Anthropic is paid) ---
# Gemini Flash: free tier (15 req/min, 1M tokens/day)
# Get key at: https://aistudio.google.com/app/apikey  (no credit card needed)
GEMINI_API_KEY=

# Anthropic Claude: paid API (~$0.0004/ticker for news, ~$0.006/ticker for vision)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
#LLM_VISION_MODEL=claude-sonnet-4-6   # chart-reading model (vision agent)
#GEMINI_MODEL=gemini-2.0-flash

# Priority: Gemini > Anthropic > keyword fallback (free, always works)

# --- News (optional, Alpaca news used if Alpaca keys set) ---
NEWS_API_KEY=

# --- Risk parameters ---
MAX_RISK_PER_TRADE_PCT=0.01
MIN_RISK_REWARD=1.5
MAX_POSITION_PCT=0.20
ATR_STOP_MULTIPLE=2.0
ATR_TARGET_MULTIPLE=3.0
MAX_OPEN_POSITIONS=5       # hard cap on concurrent open positions
MAX_DAILY_LOSS_PCT=0.03    # kill switch: halt new entries after -3% on the day

# --- Decision thresholds ---
LONG_THRESHOLD=60.0
SHORT_THRESHOLD=40.0
MIN_RISK_SCORE=35.0

# --- Execution ---
EXECUTE_LIVE=false         # must be explicitly true to send real orders in live mode

# --- Autonomous executor on the API server (Railway) ---
# When true, api_server itself places Alpaca PAPER bracket orders for strong
# recommendations (no PC needed). Requires ALPACA_PAPER=true, Alpaca keys set,
# AND the dashboard auto-execute toggle on. Arm this ONLY if no PC bot is
# trading the same account — otherwise both venues enter and you double up.
AUTO_EXECUTE_ON_RAILWAY=false
AUTO_EXEC_POLL_MIN=5       # how often (minutes) to sweep recommendations
AUTO_EXEC_MIN_SCORE=60     # conviction gate: LONG >= this, SHORT <= 100-this

# --- Nightly self-improvement (api_server) ---
# Every weekday evening the bot re-runs the walk-forward optimizer on fresh
# data and auto-applies the best params ONLY when they validated positive on
# the held-out split. Fields locked via the dashboard (manual overrides) are
# never touched. Set false to require the manual "Apply Optimal Params" click.
AUTO_OPTIMIZE=true
AUTO_OPTIMIZE_HOUR_ET=18   # run at/after this hour ET (backtest runs at 17)
AUTO_APPLY_MAX_P=0.20      # reject self-applied params whose held-out edge has
                           # a sign-flip randomization p-value above this (luck screen)

# --- Broker reconciliation (api_server) ---
# Periodically verifies trades.json against the actual Alpaca book: repairs
# trades the exit monitor can't see close (manual close, EOD close_all), and
# surfaces untracked broker positions on the health board (never auto-closed).
RECONCILE_INTERVAL_MIN=10

# --- Live runner ---
RESCAN_INTERVAL_MIN=30     # re-evaluate all tickers every N minutes in live_runner.py
EOD_FLATTEN=true           # close all positions before the bell (day-trade-only bot)
EOD_FLATTEN_MIN_BEFORE=5   # minutes before 16:00 ET to flatten

# --- Trade quality gates (live + backtest share these) ---
ENTRY_CUTOFF_MIN=60        # no NEW entries in the last N min of RTH — a fresh 3xATR
                           # target there is an EOD coin-flip (backtest always did this;
                           # live now matches). 0 disables.
MAX_SPREAD_BPS=30          # skip entries whose quoted bid-ask spread exceeds this many
                           # bps of mid — a wide spread is a round-trip cost the score
                           # never sees. 0 disables.
TIME_STOP_BARS=0           # stagnation exit after N 5-min bars with <0.25x stop-distance
                           # progress. Leave 0: the nightly optimizer tunes it (grid 0/12)
                           # and only arms it live with walk-forward evidence.

# --- Dashboard API server ---
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Telegram notifications ---
# DASHBOARD_URL is REQUIRED for trade notifications to work.
# Set it to your Vercel deployment URL (no trailing slash).
# Without it, TelegramPublisher.enabled = False and all alerts are silently dropped.
DASHBOARD_URL=https://your-app.vercel.app
TELEGRAM_BOT_TOKEN=          # BotFather token
BOT_API_SECRET=              # shared secret between Railway bot and Vercel dashboard

# --- Vercel tunnel (optional) ---
# Free static domain from https://dashboard.ngrok.com/domains (e.g. yourname.ngrok-free.app).
# When set, START.bat opens a tunnel so the Vercel-hosted dashboard can reach this PC.
NGROK_DOMAIN=
