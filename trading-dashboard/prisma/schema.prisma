generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  phone               String?
  passwordHash        String
  alpacaKeyId         String
  alpacaSecret        String
  alpacaPaper         Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  // Temporary password issued by forgot-password. Lives NEXT TO the real
  // hash (never replaces it) so an unauthenticated request can't lock the
  // account's owner out. Single-use and time-limited.
  tempPasswordHash    String?
  tempPasswordAt      DateTime?
  autoExecute         Boolean   @default(false)
  // "owner" may change shared-bot state (auto-execute, broker switch,
  // optimizer apply/reset, circuit-breaker reset); "viewer" gets read access
  // and trades their OWN Alpaca account only.
  role                String    @default("viewer")
  createdAt           DateTime  @default(now())
  telegramChatId      String?
  telegramToken       String?
  telegramTokenAt     DateTime?
  telegramActivatedAt DateTime?
}
